{
    "name": "vaccine_systemV2app",
    "appid": "__UNI__2324C6C",
    "description": "疫苗管理系统V2前端应用",
    "versionName": "1.0.0",
    "versionCode": "100",
    "transformPx": false,
    "app-plus": {
        "usingComponents": true,
        "nvueCompiler": "uni-app",
